# Paid Gemini via Vertex AI.
# Set a Google Cloud project and choose an optimal location.
# Recommended for Kazakhstan/Astana: europe-west1 (423ms median latency).
# Fallback: europe-west4 (460ms, most reliable).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
# DESCRIPTION_MODEL=gemini-2.5-flash

# Optional for Google Cloud TTS and Vertex AI ADC. Leave empty to use edge-tts for TTS.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional for Hugging Face corpus scripts.
HF_TOKEN=

# Optional reproducibility overrides.
# Uncomment these only if you want to force the same runtime on every machine.
# Leaving them commented preserves auto-detection.
# TTS_PROVIDER=edge
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_MODEL_SIZE=medium
# FFMPEG_PATH=ffmpeg
